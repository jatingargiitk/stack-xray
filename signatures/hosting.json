[
  {"id": "vercel", "name": "Vercel", "category": "hosting", "website": "https://vercel.com", "match": {"headers": ["^x-vercel-id:", "^server: vercel", "^x-vercel-cache:"], "cname": ["vercel-dns\\.com$", "\\.vercel\\.app$"], "dnsTxt": ["^vercel-domain-verification"], "text": ["\\bVercel(?:, Inc\\.?)?\\b"]}},
  {"id": "netlify", "name": "Netlify", "category": "hosting", "website": "https://netlify.com", "match": {"headers": ["^x-nf-request-id:", "^server: netlify"], "cname": ["\\.netlify\\.(?:app|com)$"], "text": ["\\bNetlify\\b"]}},
  {"id": "cloudflare-pages", "name": "Cloudflare Pages / Workers", "category": "hosting", "website": "https://pages.cloudflare.com", "match": {"cname": ["\\.pages\\.dev$", "\\.workers\\.dev$"], "hosts": ["[a-z0-9-]+\\.workers\\.dev"]}},
  {"id": "aws", "name": "AWS", "category": "hosting", "website": "https://aws.amazon.com", "match": {"headers": ["^x-amz-(?:request-id|id-2|apigw-id|cf-id):", "^server: (?:amazons3|awselb)", "^x-amzn-requestid:"], "cookies": ["^AWSALB", "^AWSELB"], "cname": ["\\.elb\\.amazonaws\\.com$", "\\.awsglobalaccelerator\\.com$", "\\.amplifyapp\\.com$", "\\.execute-api\\.[a-z0-9-]+\\.amazonaws\\.com$"], "text": ["Amazon Web Services", "\\bAWS\\b"]}},
  {"id": "gcp", "name": "Google Cloud", "category": "hosting", "website": "https://cloud.google.com", "match": {"headers": ["^server: google frontend", "^via: 1\\.1 google", "^x-cloud-trace-context:"], "cname": ["ghs\\.googlehosted\\.com$", "\\.run\\.app$", "\\.appspot\\.com$"], "text": ["Google Cloud(?: Platform)?", "\\bGCP\\b"]}},
  {"id": "azure", "name": "Microsoft Azure", "category": "hosting", "website": "https://azure.microsoft.com", "match": {"headers": ["^x-azure-ref:", "^x-ms-request-id:"], "cname": ["\\.azurewebsites\\.net$", "\\.azurefd\\.net$", "\\.azureedge\\.net$", "\\.azurestaticapps\\.net$", "\\.trafficmanager\\.net$"], "text": ["Microsoft Azure"]}},
  {"id": "fly", "name": "Fly.io", "category": "hosting", "website": "https://fly.io", "match": {"headers": ["^fly-request-id:", "^server: fly/"], "cname": ["\\.fly\\.dev$"], "text": ["Fly\\.io"]}},
  {"id": "render", "name": "Render", "category": "hosting", "website": "https://render.com", "match": {"headers": ["^rndr-id:", "^x-render-origin-server:"], "cname": ["\\.onrender\\.com$"], "text": ["Render Services"]}},
  {"id": "railway", "name": "Railway", "category": "hosting", "website": "https://railway.com", "match": {"headers": ["^x-railway-(?:request-id|edge):", "^server: railway"], "cname": ["\\.up\\.railway\\.app$"], "text": ["Railway Corp"]}},
  {"id": "heroku", "name": "Heroku", "category": "hosting", "website": "https://heroku.com", "match": {"headers": ["^via: .*vegur", "^server: heroku"], "cname": ["\\.herokudns\\.com$", "\\.herokuapp\\.com$"], "text": ["\\bHeroku\\b"]}},
  {"id": "digitalocean", "name": "DigitalOcean", "category": "hosting", "website": "https://digitalocean.com", "match": {"cname": ["\\.ondigitalocean\\.app$"], "ns": ["\\.digitalocean\\.com$"], "text": ["\\bDigitalOcean\\b"]}},
  {"id": "webflow", "name": "Webflow", "category": "hosting", "website": "https://webflow.com", "match": {"html": ["data-wf-site=", "data-wf-page="], "cname": ["proxy(?:-ssl)?\\.webflow\\.com$"], "hosts": ["(?:assets|uploads)-global\\.website-files\\.com", "cdn\\.prod\\.website-files\\.com"]}},
  {"id": "framer", "name": "Framer", "category": "hosting", "website": "https://framer.com", "match": {"html": ["<meta name=\"generator\" content=\"Framer", "framerusercontent\\.com"], "cname": ["\\.framer\\.(?:app|website)$", "sites\\.framer\\.app$"], "hosts": ["framerusercontent\\.com"]}},
  {"id": "github-pages", "name": "GitHub Pages", "category": "hosting", "website": "https://pages.github.com", "match": {"headers": ["^server: github\\.com"], "cname": ["\\.github\\.io$"]}},
  {"id": "firebase-hosting", "name": "Firebase Hosting", "category": "hosting", "website": "https://firebase.google.com/products/hosting", "match": {"cname": ["\\.web\\.app$", "\\.firebaseapp\\.com$"], "headers": ["^x-firebase-hosting"]}},
  {"id": "mintlify", "name": "Mintlify (docs)", "category": "hosting", "website": "https://mintlify.com", "match": {"cname": ["mintlify\\.(?:dev|app)$", "\\.mintlify\\.dev$"], "hosts": ["mintlify\\.s3", "mintcdn\\.com"]}},
  {"id": "gitbook", "name": "GitBook (docs)", "category": "hosting", "website": "https://gitbook.com", "match": {"cname": ["hosting\\.gitbook\\.io$", "\\.gitbook\\.io$"]}},
  {"id": "readme", "name": "ReadMe (docs)", "category": "hosting", "website": "https://readme.com", "match": {"cname": ["(?:ssl\\.)?readmessl\\.com$", "\\.readme\\.io$"]}},
  {"id": "lovable-hosting", "name": "Lovable (hosting)", "category": "hosting", "website": "https://lovable.dev", "match": {"cname": ["\\.lovable\\.app$"], "hosts": ["[a-z0-9-]+\\.lovable\\.app"]}},
  {"id": "replit-hosting", "name": "Replit Deployments", "category": "hosting", "website": "https://replit.com", "match": {"cname": ["\\.replit\\.app$", "\\.repl\\.co$"]}}
