[
  {
    "id": "openai",
    "name": "OpenAI",
    "category": "ai-provider",
    "website": "https://openai.com",
    "match": {
      "dnsTxt": ["^openai-domain-verification="],
      "hosts": ["api\\.openai\\.com", "cdn\\.platform\\.openai\\.com"],
      "js": ["OpenAI/JS", "openai/resources/", "dangerouslyAllowBrowser.{0,200}openai"],
      "text": ["\\bOpenAI\\b"]
    },
    "models": [
      "[\"'`]((?:chatgpt-4o|gpt-[0-9](?:\\.[0-9])?)(?:[a-z0-9.-]{0,30}))[\"'`]",
      "[\"'`](o[1345](?:-mini|-pro|-preview|-deep-research)?(?:-20[0-9]{2}-[0-9]{2}-[0-9]{2})?)[\"'`]",
      "[\"'`](text-embedding-(?:3-small|3-large|ada-002))[\"'`]",
      "[\"'`](whisper-1|gpt-image-1[a-z0-9.-]*|dall-e-[23]|tts-1(?:-hd)?|sora-[0-9][a-z0-9.-]*)[\"'`]"
    ],
    "note": "An openai-domain-verification TXT record proves an OpenAI account (often ChatGPT Enterprise), not that the product calls the API."
  },
  {
    "id": "anthropic",
    "name": "Anthropic (Claude)",
    "category": "ai-provider",
    "website": "https://anthropic.com",
    "match": {
      "dnsTxt": ["^anthropic-domain-verification"],
      "hosts": ["api\\.anthropic\\.com"],
      "js": ["Anthropic/JS", "anthropic-dangerous-direct-browser-access", "[\"']anthropic-version[\"']"],
      "text": ["\\bAnthropic\\b"]
    },
    "models": ["[\"'`](claude-(?:opus|sonnet|haiku|instant|[0-9])[a-z0-9.@-]{0,40})[\"'`]"],
    "note": "An anthropic-domain-verification TXT record proves a Claude/Anthropic Console account, not that the product calls the API."
  },
