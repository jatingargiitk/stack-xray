    },
    "models": ["[\"'`](gemini-[0-9][a-z0-9.-]{0,40})[\"'`]", "[\"'`](imagen-[0-9][a-z0-9.-]*|veo-[0-9][a-z0-9.-]*)[\"'`]"]
