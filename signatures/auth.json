  {"id": "descope", "name": "Descope", "category": "auth", "website": "https://descope.com", "match": {"hosts": ["api\\.descope\\.com"], "text": ["\\bDescope\\b"]}},
  {"id": "kinde", "name": "Kinde", "category": "auth", "website": "https://kinde.com", "match": {"hosts": ["[a-z0-9-]+\\.kinde\\.com"], "text": ["\\bKinde\\b"]}},
